# ── Dependencies ────────────────────────────────────────────────────
node_modules
npm-debug.log*

# ── Build output (will be regenerated inside the container) ─────────
dist
build

# ── Git ───────────────────────────────────────────────────────────────
.git
.gitignore

# ── Environment files (never bake secrets into an image) ─────────────
.env
.env.*
!.env.example

# ── Editor / OS clutter ────────────────────────────────────────────────
.vscode
.idea
.DS_Store
Thumbs.db

# ── Docker-related files themselves ───────────────────────────────────
Dockerfile
.dockerignore

# ── Docs / non-runtime files (safe to exclude from the image) ────────
README.md
*.md

# ── Test/CI artifacts, if you add them later ──────────────────────────
coverage
.nyc_output
